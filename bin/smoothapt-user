#!/bin/sh
# Manage the per-user certificates of an access-controlled archive.
#
#   smoothapt-user add    <archive> <id>   issue a certificate (smoothapt-image uses it)
#   smoothapt-user revoke <archive> <id>   withdraw it; apt is refused at once
#   smoothapt-user list   <archive>        ids with access
#
# A user's credential is a client certificate issued by smoothapt's CA, with
# the user id as its subject. It and its key stay on this server
# (<archive>.keys/<id>.pem, root only); smoothapt-image makes it part of the
# images built for that user, and apt presents it on every request. The host's nginx checks it against the CA;
# this container's nginx refuses revoked serials (a file per serial in
# <archive>.revoked/, checked per request) and logs every request with
# the id. Every add and revoke is appended to <archive>.log.
set -eu

CA=/etc/smoothapt/ca
DIR=/etc/smoothapt/users
DAYS=36500   # revocation, not expiry, ends a credential

usage() { sed -n '3,5s/^# //p' "$0" >&2; exit 2; }

[ $# -ge 2 ] || usage
cmd=$1 archive=$2
case $archive in *[!a-z0-9-]* | '') echo "bad archive name: $archive" >&2; exit 2 ;; esac
index=$DIR/$archive.certs      # "<id> <serial>" per issued certificate
keys=$DIR/$archive.keys        # <id>.pem: certificate and key, root only
revoked=$DIR/$archive.revoked  # one empty file per revoked serial
[ -f "$index" ] || { echo "$archive has no user list ($index)" >&2; exit 1; }

exec 9>"$DIR/.lock"
flock 9

serial_of() { awk -v id="$1" '$1 == id { print $2 }' "$index"; }
record() { echo "$(date -u +%FT%TZ) $1 $2" >> "$DIR/$archive.log"; }

case $cmd in
add)
    [ $# -eq 3 ] || usage
    id=$3
    case $id in *[!a-z0-9._-]* | '' | [._-]*) echo "bad id: $id (a-z 0-9 . _ -)" >&2; exit 2 ;; esac
    [ -z "$(serial_of "$id")" ] || { echo "$id already has access to $archive" >&2; exit 1; }
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 -out "$tmp/key.pem" 2>/dev/null
    openssl req -new -key "$tmp/key.pem" -subj "/O=$archive/CN=$id" -out "$tmp/req.pem"
    printf 'basicConstraints=critical,CA:FALSE\nkeyUsage=critical,digitalSignature\nextendedKeyUsage=clientAuth\n' > "$tmp/ext"
    openssl x509 -req -in "$tmp/req.pem" -CA "$CA/ca.crt" -CAkey "$CA/ca.key" \
        -set_serial "0x$(openssl rand -hex 16)" -days "$DAYS" -sha256 \
        -extfile "$tmp/ext" -out "$tmp/cert.pem" 2>/dev/null
    serial=$(openssl x509 -in "$tmp/cert.pem" -noout -serial | cut -d= -f2)
    install -d -m 700 "$keys"
    (umask 077; cat "$tmp/cert.pem" "$tmp/key.pem" > "$keys/$id.pem")
    echo "$id $serial" >> "$index"
    record add "$id $serial"
    openssl x509 -in "$tmp/cert.pem" -noout -subject -serial
    ;;
revoke)
    [ $# -eq 3 ] || usage
    id=$3
    serial=$(serial_of "$id")
    [ -n "$serial" ] || { echo "$id has no access to $archive" >&2; exit 1; }
    install -m 644 /dev/null "$revoked/$serial"
    awk -v id="$id" '$1 != id' "$index" > "$index.tmp" && mv "$index.tmp" "$index"
    rm -f "$keys/$id.pem"
    record revoke "$id $serial"
    ;;
list)
    cut -d' ' -f1 "$index"
    ;;
*) usage ;;
esac
