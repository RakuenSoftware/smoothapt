#!/usr/bin/python3
"""Ingest Smooth* GitHub releases into the apt archives.

For every project in conf/sources, each release not seen before is downloaded,
every .deb in it is checked against its GitHub build-provenance attestation,
and only if all of them verify are they added to the project's suite. A release
that fails verification is recorded as rejected, with the reason, and never
retried; a network or GitHub error leaves it to the next run.

The archive keeps the packages of the newest KEEP releases of each project.
A package name that only older releases carry (a per-build kernel such as
linux-image-7.2.10-70-smoothkernel) is removed with them; names every release
carries (the metapackages, linux-libc-dev, ZFS) just move to the new version.

Runs as the smoothapt user from smoothapt-ingest.timer. Nothing here builds,
re-signs or re-versions a package: what is served is what the pipeline built.
"""

import fcntl
import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request

import snappy

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
SOURCES = os.path.join(ROOT, "conf", "sources")
ARCHIVES = "/var/lib/smoothapt/archives"
STATE = "/var/lib/smoothapt/state"
KEEP = 3
OIDC_ISSUER = "https://token.actions.githubusercontent.com"
API = "https://api.github.com"


class Rejected(Exception):
    """The release can never be ingested as published."""


def log(msg):
    print(msg, flush=True)


def fetch(url, accept="application/vnd.github+json"):
    req = urllib.request.Request(url, headers={
        "Accept": accept,
        "User-Agent": "smoothapt",
        "X-GitHub-Api-Version": "2022-11-28",
    })
    with urllib.request.urlopen(req, timeout=120) as resp:
        return resp.read()


def fetch_json(url):
    return json.loads(fetch(url))


def download(url, path):
    req = urllib.request.Request(url, headers={"User-Agent": "smoothapt"})
    h = hashlib.sha256()
    with urllib.request.urlopen(req, timeout=600) as resp, open(path, "wb") as out:
        while chunk := resp.read(1 << 20):
            h.update(chunk)
            out.write(chunk)
    return h.hexdigest()


def read_sources():
    sources = []
    with open(SOURCES) as f:
        for n, line in enumerate(f, 1):
            line = line.split("#", 1)[0].split()
            if not line:
                continue
            if len(line) != 4:
                sys.exit(f"{SOURCES}:{n}: expected <repo> <archive> <suite> <workflow>")
            repo, archive, suite, workflow = line
            sources.append(dict(repo=repo, archive=archive, suite=suite,
                                workflow=workflow))
    return sources


def state_path(repo):
    return os.path.join(STATE, repo.replace("/", "__") + ".json")


def load_state(repo):
    try:
        with open(state_path(repo)) as f:
            return json.load(f)
    except FileNotFoundError:
        return {"ingested": {}, "rejected": {}}


def save_state(repo, state):
    path = state_path(repo)
    with open(path + ".tmp", "w") as f:
        json.dump(state, f, indent=1, sort_keys=True)
    os.replace(path + ".tmp", path)


def verify(src, deb, digest, workdir):
    """Check deb's attestation: signed by src's workflow, on main or a v* tag."""
    try:
        data = fetch_json(f"{API}/repos/{src['repo']}/attestations/sha256:{digest}")
    except urllib.error.HTTPError as e:
        if e.code == 404:
            raise Rejected(f"{os.path.basename(deb)}: no attestation")
        raise
    identity = (rf"^https://github\.com/{re.escape(src['repo'])}/\.github/workflows/"
                rf"{re.escape(src['workflow'])}@refs/(heads/main|tags/v.+)$")
    errors = []
    for i, att in enumerate(data.get("attestations", [])):
        bundle = os.path.join(workdir, f"{digest}.{i}.bundle.json")
        # Unauthenticated, GitHub leaves "bundle" empty and links the bundle,
        # snappy-compressed, from "bundle_url" instead.
        with open(bundle, "wb") as f:
            if att.get("bundle"):
                f.write(json.dumps(att["bundle"]).encode())
            else:
                f.write(snappy.uncompress(fetch(att["bundle_url"], accept="*/*")))
        r = subprocess.run(
            ["cosign", "verify-blob-attestation", "--new-bundle-format",
             "--bundle", bundle, "--type", "slsaprovenance1",
             "--certificate-oidc-issuer", OIDC_ISSUER,
             "--certificate-identity-regexp", identity, deb],
            capture_output=True, text=True)
        if r.returncode == 0:
            return
        errors.append(r.stderr.strip().splitlines()[-1] if r.stderr.strip() else f"exit {r.returncode}")
    raise Rejected(f"{os.path.basename(deb)}: no attestation verifies: {'; '.join(errors) or 'none listed'}")


def deb_name(path):
    return subprocess.run(["dpkg-deb", "-f", path, "Package"], check=True,
                          capture_output=True, text=True).stdout.strip()


def reprepro(archive, *args):
    r = subprocess.run(["reprepro", "-b", os.path.join(ARCHIVES, archive), *args],
                       capture_output=True, text=True)
    if r.returncode != 0:
        raise RuntimeError(f"reprepro {' '.join(args[:2])}: {r.stderr.strip() or r.stdout.strip()}")
    return r.stdout


def ingest_release(src, rel):
    debs = [a for a in rel["assets"] if a["name"].endswith(".deb")
            # Debug symbols are a GitHub-release download, not an apt package.
            and "-dbg_" not in a["name"]]
    if not debs:
        raise Rejected("no .deb assets")
    with tempfile.TemporaryDirectory(prefix="smoothapt-") as tmp:
        paths = []
        for a in debs:
            path = os.path.join(tmp, a["name"])
            digest = download(a["browser_download_url"], path)
            verify(src, path, digest, tmp)
            paths.append(path)
        names = sorted({deb_name(p) for p in paths})
        try:
            reprepro(src["archive"], "includedeb", src["suite"], *paths)
        except RuntimeError as e:
            raise Rejected(str(e))
    return names


def prune(src, state):
    """Drop package names carried only by releases older than the newest KEEP."""
    rels = sorted(state["ingested"].items(), key=lambda kv: kv[1]["published_at"])
    keep = {n for _, r in rels[-KEEP:] for n in r["packages"]}
    for tag, r in rels[:-KEEP]:
        gone = [n for n in r["packages"] if n not in keep]
        if gone:
            reprepro(src["archive"], "remove", src["suite"], *gone)
            log(f"{src['repo']} {tag}: removed {' '.join(gone)}")
        del state["ingested"][tag]


def run(src):
    state = load_state(src["repo"])
    releases = fetch_json(f"{API}/repos/{src['repo']}/releases?per_page=30")
    releases.sort(key=lambda r: r["published_at"] or "")
    for rel in releases:
        tag = rel["tag_name"]
        if rel["draft"] or tag in state["ingested"] or tag in state["rejected"]:
            continue
        # Older than what is already here: it was superseded before smoothapt
        # saw it, and apt would never pick it anyway.
        newest = max((r["published_at"] for r in state["ingested"].values()), default="")
        if rel["published_at"] < newest:
            continue
        try:
            names = ingest_release(src, rel)
        except Rejected as e:
            state["rejected"][tag] = {"reason": str(e), "at": time.strftime("%FT%TZ", time.gmtime())}
            save_state(src["repo"], state)
            log(f"{src['repo']} {tag}: REJECTED: {e}")
            continue
        state["ingested"][tag] = {"published_at": rel["published_at"], "packages": names}
        prune(src, state)
        save_state(src["repo"], state)
        log(f"{src['repo']} {tag}: ingested into {src['archive']}/{src['suite']}: {' '.join(names)}")


def main():
    os.makedirs(STATE, exist_ok=True)
    lock = open(os.path.join(STATE, ".lock"), "w")
    fcntl.flock(lock, fcntl.LOCK_EX)
    failed = False
    for src in read_sources():
        try:
            run(src)
        except Exception as e:  # one project's outage must not block the others
            log(f"{src['repo']}: {type(e).__name__}: {e}")
            failed = True
    sys.exit(1 if failed else 0)


if __name__ == "__main__":
    main()
